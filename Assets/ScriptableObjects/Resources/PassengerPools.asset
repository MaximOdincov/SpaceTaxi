  Names:
  - "\u0410\u0433\u0430\u0444\u043e\u043d"
  - "\u0410\u043b\u0434\u0430\u043d"
  - "\u0411\u043e\u0433\u0434\u0430\u043d"
  - "\u0412\u0435\u043b\u0438\u043c\u0438\u0440"
  - "\u0412\u0435\u043d\u0435\u0434\u0438\u043a\u0442"
  - "\u0413\u0435\u043b\u0438\u0439"
  - "\u0414\u043e\u0440\u043e\u0444\u0435\u0439"
  - "\u0415\u0432\u0441\u0442\u0438\u0433\u043d\u0435\u0439"
  - "\u0415\u0440\u043e\u0444\u0435\u0439"
  - "\u0417\u0435\u043d\u043e\u043d"
  - "\u0418\u043b\u0430\u0440\u0438\u0439"
  - "\u041a\u0430\u0441\u043f\u0430\u0440"
  - "\u041b\u0443\u043a\u044c\u044f\u043d"
  - "\u041c\u0435\u0444\u043e\u0434\u0438\u0439"
  - "\u041d\u0438\u043a\u0430\u043d\u043e\u0440"
  - "\u041f\u0440\u043e\u0445\u043e\u0440"
  - "\u0420\u043e\u0441\u0442\u0438\u0441\u043b\u0430\u0432"
  - "\u0421\u0430\u0432\u0432\u0430"
  - "\u0422\u0438\u0445\u043e\u043d"
  - "\u0423\u0441\u0442\u0438\u043d"
  - "\u0424\u0440\u043e\u043b"
  - "\u0425\u0430\u0440\u0438\u0442\u043e\u043d"
  - "\u0427\u0435\u0441\u043b\u0430\u0432"
  - "\u042e\u043b\u0438\u0430\u043d"
  Surnames:
  - "\u0421\u0442\u0443\u0436\u0435\u0432"
  - "\u041f\u0435\u043a\u043b\u043e\u0432"
  - "\u0413\u0440\u0430\u0432\u0438\u0435\u0432"
  - "\u0422\u044f\u0433\u0443\u043d\u043e\u0432"
  - "\u041f\u0435\u0440\u0438\u043e\u0434\u044c\u0435\u0432"
  - "\u0418\u043e\u043d\u0438\u0437\u0438\u043d"
  - "\u0422\u0435\u0440\u043c\u043e\u044f\u0440\u0446\u0435\u0432"
  - "\u042d\u043a\u0438\u043f\u0430\u0436\u0435\u0432"
  - "\u041f\u0440\u0438\u0431\u043e\u0440\u044c\u0435\u0432"
  - "\u0421\u0442\u044b\u043a\u043e\u0432\u0441\u043a\u0438\u0439"
  - "\u0420\u0435\u0442\u0440\u043e\u0433\u0440\u0430\u0434\u043e\u0432"
  - "\u0421\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u043e\u0432"
  - "\u041a\u0430\u043b\u043e\u0440\u0438\u0444\u0435\u0440\u043e\u0432"
  - "\u0414\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u043e\u0432"
  - "\u0428\u043a\u0430\u043b\u0438\u043a\u043e\u0432"
  - "\u0414\u0430\u0442\u0447\u0438\u043a\u043e\u0432"
  - "\u0424\u0438\u0442\u0438\u043b\u0435\u0432"
  - "\u041f\u0430\u044f\u043b\u044c\u043d\u0438\u043a\u043e\u0432"
  - "\u041a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u0432"
  - "\u0410\u043c\u043e\u0440\u0442\u0438\u0437\u043e\u0432"
  - "\u0411\u043e\u0440\u0442\u043c\u0435\u0445\u043e\u0432"
  - "\u0421\u0442\u0440\u043e\u043f\u043e\u0432"
  - "\u0422\u0440\u043e\u0441\u0438\u043a\u043e\u0432"
  - "\u041a\u044e\u0432\u0435\u0442\u043e\u0432"
  Greetings:
  - "\u0414\u0438\u0441\u043f\u0435\u0442\u0447\u0435\u0440 \u0441\u043a\u0430\u0437\u0430\u043b, \u0432\u044b \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b? \u041e\u043f\u0430\u0437\u0434\u044b\u0432\u0430\u044e \u0441\u0442\u0440\u0430\u0448\u043d\u043e."
  - "\u0422\u0430\u043a, \u0432\u044b \u0442\u0430\u043a\u0441\u0438? \u0421\u0430\u0434\u0438\u043c\u0441\u044f, \u0432\u0440\u0435\u043c\u044f!"
  - "\u041d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e! \u042f \u0443\u0436\u0435 \u0434\u0443\u043c\u0430\u043b, \u0432\u044b \u0443\u043b\u0435\u0442\u0435\u043b\u0438."
  - "\u0422\u043e\u0432\u0430\u0440 \u043d\u0435\u043f\u0440\u0438\u0442\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u043d\u043e \u0434\u043e\u0440\u043e\u0433\u043e\u0439. \u041f\u043e\u0435\u0445\u0430\u043b\u0438 \u0442\u0438\u0445\u043e."
  - "\u0417\u0434\u043e\u0440\u043e\u0432. \u0413\u0440\u0443\u0437 \u2014 \u044f, \u043f\u043e\u0433\u043e\u043d\u044f\u0435\u043c \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e."
  - "\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u044e \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u043e\u0432. \u041d\u0430\u0447\u043d\u0451\u043c."
  - "\u041f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0437 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435! \u041a\u0430\u043a\u0438\u0435 \u0442\u0443\u0442 \u043a\u0440\u0430\u0441\u043e\u0442\u044b?"
  - "\u0423 \u043c\u0435\u043d\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u043c\u0435\u0447\u0442\u044b, \u0432\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c."
  - "\u0414\u043e\u0441\u0442\u0430\u043b\u0438 \u043f\u0443\u0442\u0435\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c! \u0413\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u043e\u0431\u043b\u0430\u043a\u0430."
  - "\u0414\u043e\u0431\u0440\u044b\u0439 \u0434\u0435\u043d\u044c. \u0422\u043e\u043b\u044c\u043a\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0431\u0435\u0437 \u0440\u0435\u0437\u043a\u043e\u0441\u0442\u0435\u0439."
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435. \u041c\u043d\u0435 \u0431\u044b \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u0439 \u0440\u0435\u0439\u0441."
  - "\u041f\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e. \u0410\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u0435\u0435, \u0443 \u043c\u0435\u043d\u044f \u0441\u043b\u0430\u0431\u043e\u0435 \u0441\u0435\u0440\u0434\u0446\u0435."
  - "\u041f\u0440\u0438\u0432\u0435\u0442! \u0410 \u043c\u043e\u0436\u043d\u043e \u0441 \u0432\u0435\u0442\u0435\u0440\u043a\u043e\u043c, \u043d\u043e \u043d\u0435 \u0443\u043c\u0438\u0440\u0430\u0442\u044c?"
  - "\u0417\u043d\u0430\u0435\u0442\u0435, \u0432\u043e \u0441\u043d\u0435 \u043c\u043d\u0435 \u0432\u0435\u043b\u0435\u043b\u0438 \u0441\u044e\u0434\u0430 \u0435\u0445\u0430\u0442\u044c."
  - "\u042f \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u044e \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f. \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u0430\u0448\u0430 \u043e\u0447\u0435\u0440\u0435\u0434\u044c."
  Wishes:
  - "\u041e\u043f\u0430\u0437\u0434\u044b\u0432\u0430\u044e! \u0414\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043c\u0435\u043d\u044f \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u0435\u043a, \u043f\u0440\u043e\u0448\u0443."
  - "\u041c\u043d\u0435 \u043a \u0441\u0440\u043e\u043a\u0443, \u043a\u0430\u0436\u0434\u0430\u044f \u043c\u0438\u043d\u0443\u0442\u0430 \u043d\u0430 \u0441\u0447\u0435\u0442\u0443. \u041f\u043e\u0442\u043e\u0440\u043e\u043f\u0438\u0442\u0435\u0441\u044c."
  - "\u041d\u0435 \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u0441\u044f \u0432 \u043f\u0443\u0442\u0438. \u041c\u043d\u0435 \u043b\u0438\u0448\u043d\u0438\u0435 \u0433\u043b\u0430\u0437\u0430 \u043d\u0430 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043d\u0435 \u043d\u0443\u0436\u043d\u044b."
  - "\u0411\u0435\u0440\u0435\u0436\u0451\u043d\u044b\u0439 \u0433\u0440\u0443\u0437: \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f, \u043f\u043e\u043d\u044f\u043b?"
  - "\u041f\u043e\u043a\u0430\u0436\u0438\u0442\u0435 \u043a\u043e\u043c\u0435\u0442\u0443! \u0425\u043e\u0447\u0443 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043d\u0430 \u043f\u0430\u043c\u044f\u0442\u044c."
  - "\u041e\u0431\u043b\u0435\u0442\u0438\u043c \u043a\u043e\u043b\u044c\u0446\u043e \u043f\u043b\u0430\u043d\u0435\u0442\u044b? \u0418\u0437\u043d\u0443\u0442\u0440\u0438 \u0432\u0438\u0434\u0430 \u043d\u0435\u0442."
  - "\u0421 \u0442\u0435\u043d\u0435\u0432\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0437\u0432\u0435\u0437\u0434\u044b \u2014 \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0432\u0438\u0434 \u043d\u0435\u043e\u0431\u044b\u043a\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0439."
  - "\u0422\u0438\u0448\u0435 \u0435\u0434\u0435\u043c \u2014 \u0434\u0430\u043b\u044c\u0448\u0435 \u0431\u0443\u0434\u0435\u043c. \u041d\u0435 \u0440\u0430\u0437\u0433\u043e\u043d\u044f\u0439\u0442\u0435\u0441\u044c \u0441\u043b\u0438\u0448\u043a\u043e\u043c."
  - "\u0411\u0435\u0437 \u0442\u0440\u044f\u0441\u043e\u043a, \u0443\u043c\u043e\u043b\u044f\u044e. \u042f \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0440\u044f\u0441\u0443\u0441\u044c."
  - "\u041c\u0438\u043c\u043e \u0431\u0435\u0437\u0434\u043d\u044b! \u041a \u0447\u0451\u0440\u043d\u043e\u0439 \u0434\u044b\u0440\u0435 \u043f\u043e\u0431\u043b\u0438\u0436\u0435, \u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0436\u0438\u0432\u044b \u043e\u0431\u0430."
  - "\u041f\u043e\u0441\u0438\u0434\u0438\u043c \u043f\u0435\u0440\u0435\u0434 \u0441\u0442\u0430\u0440\u0442\u043e\u043c \u043c\u0438\u043d\u0443\u0442\u0443. \u0422\u0438\u0448\u0438\u043d\u0430 \u2014 \u0442\u043e\u0436\u0435 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435."
  Thanks:
  - "\u0411\u044b\u0441\u0442\u0440\u043e! \u041a\u0430\u043a \u043f\u043e \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044e. \u0414\u0435\u0440\u0436\u0438\u0442\u0435, \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u043b\u0438."
  - "\u0413\u043e\u043d\u044f\u043b\u0438 \u043d\u0430 \u0441\u043e\u0432\u0435\u0441\u0442\u044c. \u0421\u043f\u0430\u0441\u0438\u0431\u043e!"
  - "\u0412\u043e\u0432\u0440\u0435\u043c\u044f! \u0412\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435 \u2014 \u0447\u0435\u0441\u0442\u043d\u043e\u0435."
  - "\u0413\u0440\u0443\u0437 \u0446\u0435\u043b, \u0441\u0434\u0435\u043b\u043a\u0430 \u0447\u0438\u0441\u0442\u0430\u044f. \u0414\u0435\u0440\u0436\u0438 \u043f\u0440\u0435\u043c\u0438\u044e."
  - "\u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0448\u044c \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e, \u0443\u0432\u0430\u0436\u0430\u044e."
  - "\u041f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e! \u041b\u0443\u0447\u0448\u0438\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u0436\u0438\u0437\u043d\u0438."
  - "\u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0443\u0434\u0430\u043b\u0438\u0441\u044c! \u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c."
  - "\u0412\u044b \u043d\u0435 \u0432\u043e\u0437\u0438\u0442\u0435 \u2014 \u0432\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0435. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e."
  - "\u041a\u0430\u043a \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e... \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0432\u0430\u043c."
  - "\u0415\u0445\u0430\u043b\u0438 \u0442\u0438\u0445\u043e, \u0434\u043e\u0435\u0445\u0430\u043b \u0436\u0438\u0432\u044b\u043c. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e."
  - "\u041e\u0411\u0410\u041b\u0414\u0415\u0422\u042c. \u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u043a\u0430!"
  - "\u0421\u0442\u0440\u0430\u043d\u043d\u043e, \u0447\u0443\u0434\u0435\u0441\u043d\u043e, \u0441\u043f\u0430\u0441\u0438\u0431\u043e!"
  - "\u0412\u044b \u0432 \u043c\u043e\u0451\u043c \u0441\u043f\u0438\u0441\u043a\u0435 \u043b\u0435\u0433\u0435\u043d\u0434."
  Complaints:
  - "\u042d\u0422\u041e \u0427\u0422\u041e, \u0418\u0417-\u0417\u0410 \u0412\u0410\u0421 \u042f \u041e\u041f\u041e\u0417\u0414\u0410\u041b?!"
  - "\u0422\u0430\u043a\u0441\u0438 \u043a\u0430\u043a \u0442\u0430\u043a\u0441\u0438, \u0430 \u0441\u0440\u043e\u043a\u0438 \u2014 \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430..."
  - "\u0426\u0430\u0440\u0430\u043f\u0438\u043d\u0430! \u041a\u0442\u043e \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u0442 \u0437\u0430 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044e?!"
  - "\u0421 \u0442\u043e\u0431\u043e\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0441\u044c."
  - "\u0418 \u044d\u0442\u043e \u0412\u0421\u042f \u044d\u043a\u0441\u043a\u0443\u0440\u0441\u0438\u044f?"
  - "\u042f \u0432\u0438\u0434\u0435\u043b \u043b\u0443\u0447\u0448\u0438\u0435 \u0432\u0438\u0434\u044b \u0438\u0437 \u0438\u043b\u043b\u044e\u043c\u0438\u043d\u0430\u0442\u043e\u0440\u0430 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0446\u044b."
  - "\u042f \u0436\u0435 \u043f\u0440\u043e\u0441\u0438\u043b... \u0431\u0435\u0437 \u0440\u0435\u0437\u043a\u043e\u0441\u0442\u0435\u0439..."
  - "\u041e\u0445. \u041c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0441\u0438\u0434\u0435\u0442\u044c."
  - "\u0414\u0430\u0436\u0435 \u0434\u044b\u0440\u044b \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438..."
  - "\u0421\u043a\u0443\u0447\u043d\u043e. \u0423 \u0432\u0430\u0441 \u0442\u0443\u0442 \u0441\u043a\u0443\u0447\u043d\u043e."
